{
  "name": "maestro-ui-test-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Maestro UI tests for the WebdriverIO Native Demo App",
  "scripts": {
    "maestro": "node ./scripts/maestro.js",
    "test": "node ./scripts/maestro.js test Flows",
    "test:flow": "node ./scripts/maestro.js test",
    "mcp": "node ./scripts/maestro.js mcp --working-dir .",
    "mcp:no-viewer": "node ./scripts/maestro.js mcp --no-viewer --working-dir ."
  },
  "mcpServers": {
    "maestro": {
      "command": "node",
      "args": [
        "./scripts/maestro.js",
        "mcp",
        "--working-dir",
        "."
      ]
    }
  },
  "bin": {
    "maestro": "./scripts/maestro.js"
  }
}
